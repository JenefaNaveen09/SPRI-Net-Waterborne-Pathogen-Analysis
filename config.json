{
  "project": "WaterPath-MTLNet",
  "data_root": "/content/gdrive/MyDrive/dataset/waterborne",
  "output_dir": "/content/gdrive/MyDrive/dataset/waterborne/q1_outputs",
  "encoder": "convnextv2_tiny.fcmae_ft_in22k_in1k",
  "image_size": 384,
